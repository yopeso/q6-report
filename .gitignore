# What Gradle and Kotlin leave beside the recorder and its test suite.
.gradle/
.kotlin/
build/
# What an editor's Java extension builds beside a Gradle project it opens.
bin/
__pycache__/
# What the recorder test's behave suite saves its screenshots into.
recorder-test/behave/screenshots/
# What a newer pip leaves beside the recorder when it builds the wheel in place.
*.egg-info/

# What pnpm pack builds.
dist/
# What the release workflow builds, and what gh run download brings back of it.
out/

# What pnpm installs.
node_modules/
