{
  "name": "q6-report",
  "version": "0.1.0",
  "description": "A test report with history that opens from one file, with no server and no network",
  "license": "Apache-2.0",
  "author": {
    "name": "Leo Mustatea, Yopeso",
    "email": "49692509+leonardmustatea@users.noreply.github.com",
    "url": "https://www.yopeso.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopeso/q6-report.git"
  },
  "homepage": "https://github.com/yopeso/q6-report#readme",
  "bugs": {
    "url": "https://github.com/yopeso/q6-report/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "bin": {
      "q6-report": "dist/cli.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "env -u npm_config_use_node_version node --import tsx --test tests/*.test.ts",
    "build": "tsx build.ts",
    "prepack": "tsx build.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:names && pnpm check:report && pnpm check:recorders",
    "check:names": "node scripts/check-names.mjs",
    "check:report": "tsx scripts/check-report.ts",
    "check:recorders": "tsx recorder-test/run.ts",
    "set-version": "node scripts/version.mjs set"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "webdriverio": "^9.31.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "edgedriver",
      "geckodriver"
    ]
  }
}
